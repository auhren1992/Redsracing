
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user has specific role
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Privilege checks trust Auth custom claims ONLY.
    // Firestore users/{uid}.role / isAdmin flags must not grant privilege (clients can write their own docs).
    function hasProfileRole(role) {
      return hasRole(role);
    }

    function isPrivilegedStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'team-member' ||
        request.auth.token.admin == true ||
        request.auth.token.teamMember == true
      );
    }

    function isAdminOnly() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        request.auth.token.admin == true
      );
    }

    // Privilege / staff fields that clients must never self-assign.
    function privilegeKeys() {
      return ['role', 'isAdmin', 'isTeamMember', 'isOwner', 'admin', 'teamMember', 'owner'];
    }

    function ownerProfileWriteSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegeKeys());
    }

    function ownerProfileCreateSafe() {
      return !request.resource.data.keys().hasAny(privilegeKeys());
    }
    
    // ========================================
    // PUBLIC ACCESS RULES (No auth required)
    // ========================================

    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 6 && email.size() <= 254
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // Only allow writes that don't introduce unexpected fields.
    function onlyHasKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }
    
    // Newsletter subscribers - MUST BE FIRST
    match /subscribers/{subscriberId} {
      allow create: if
        onlyHasKeys(['email', 'createdAt', 'subscribed', 'source']) &&
        isValidEmail(request.resource.data.email) &&
        // Keep sources reasonably small to avoid junk payloads
        (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 50)) &&
        true; // Anyone can subscribe
      // Do not allow public list/harvest of subscriber emails.
      allow get: if isPrivilegedStaff();
      allow list: if isPrivilegedStaff();
      allow update, delete: if isPrivilegedStaff();
    }
    
    // Users collection - profiles
    match /users/{userId} {
      // Public profiles are world-readable; otherwise owner or staff only (no full-user harvest).
      allow get: if (resource.data.publicProfile == true) || isOwner(userId) || isPrivilegedStaff();
      allow list: if isPrivilegedStaff();
      // Owners may create/update their own profile but cannot set privilege fields.
      // Staff with Auth custom claims may write any profile (role grants via Admin SDK preferred).
      allow create: if (isOwner(userId) && ownerProfileCreateSafe()) || isPrivilegedStaff();
      allow update: if (isOwner(userId) && ownerProfileWriteSafe()) || isPrivilegedStaff();
      allow delete: if isAdminOnly();
    }

    // User achievements
    match /user_achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isPrivilegedStaff();
    }

    // Available achievements
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isPrivilegedStaff();
    }
    
    // Gallery images
    match /gallery_images/{imageId} {
      // Public/staff/uploader only — unapproved pending uploads are not world-readable
      allow read: if resource.data.approved == true
                  || isPrivilegedStaff()
                  || (isAuthenticated() && request.auth.uid == resource.data.uploaderUid);
      // On create, validate uploader matches auth user and cannot self-approve
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.uploaderUid &&
        request.resource.data.approved == false;
      // On update, allow uploader (caption/altText/tags only — cannot self-approve) or staff
      allow update: if isPrivilegedStaff() ||
        (isAuthenticated() &&
         request.auth.uid == resource.data.uploaderUid &&
         request.resource.data.approved == resource.data.approved);
      allow delete: if hasRole('team-member') || hasProfileRole('team-member') || hasRole('admin') || hasProfileRole('admin');

      // Comments subcollection — moderated
      match /comments/{commentId} {
        // Public read for approved comments; staff can read all
        allow read: if (resource.data.approved == true)
                    || isPrivilegedStaff();
        // Signed-in users can create with approved=false; cannot self-approve
        allow create: if isAuthenticated() &&
          request.auth.uid == request.resource.data.authorUid &&
          request.resource.data.approved == false &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 2000;
        // Only admins/team can update approved/flagged or delete
        allow update, delete: if isPrivilegedStaff();
      }
    }

    // Per-page SEO meta (admin-edited, public read for runtime bootstrap)
    match /page_meta/{slug} {
      allow read: if true;
      allow write: if isPrivilegedStaff();
    }

    // Crew profiles (public read, admin write)
    match /crew_profiles/{slug} {
      allow read: if true;
      allow write: if isPrivilegedStaff();
    }
    
    // Race schedule (old)
    match /races/{raceId} {
      allow read: if true; // Public read for race schedule
      allow write: if hasRole('team-member') || hasProfileRole('team-member') || hasRole('admin') || hasProfileRole('admin');
    }
    
    // Race results (new - managed via Python API)
    match /race_results/{resultId} {
      allow read: if true; // Public read for race results
      allow write: if hasRole('team-member') || hasProfileRole('team-member') || hasRole('admin') || hasProfileRole('admin'); // Only team members can add results
    }

    // CMS pages and sections (public read, admin write)
    match /pages/{slug} {
      allow read: if true;
      allow write: if hasRole('admin') || hasProfileRole('admin');

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if hasRole('admin') || hasProfileRole('admin');
      }

      match /versions/{versionId} {
        allow read: if true;
        allow write: if hasRole('admin') || hasProfileRole('admin');
      }
    }
    
    // Q&A submissions
    match /qna_submissions/{submissionId} {
      // Public can read published questions; team-members/admins can read all
      allow read: if (resource.data.status == 'published')
                  || hasRole('team-member') || hasRole('admin')
                  || hasProfileRole('team-member') || hasProfileRole('admin');
      allow create: if isAuthenticated() &&
        onlyHasKeys(['question', 'status', 'submitterUid', 'submitterName', 'submittedAt']) &&
        isNonEmptyString(request.resource.data.question) &&
        request.resource.data.question.size() <= 2000 &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.submitterUid == request.auth.uid &&
        // submitterName is optional-ish; if present keep it short
        (!('submitterName' in request.resource.data) || (request.resource.data.submitterName is string && request.resource.data.submitterName.size() <= 80));
      // Moderation (answer/publish/reject) restricted to team-members/admins (claims or users doc role)
      allow update: if hasRole('team-member') || hasRole('admin')
                    || hasProfileRole('team-member') || hasProfileRole('admin');
    }
    
    // Invitation codes
    match /invitation_codes/{codeId} {
      // Team members or admins can read (via claim or users doc fallback)
      allow read: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      // Only admins can create/update/delete (via claim or users doc fallback)
      allow create: if hasRole('admin') || hasProfileRole('admin');
      allow update: if hasRole('admin') || hasProfileRole('admin');
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }

    // Site configuration (e.g., config/tiktok, config/photo_of_week, config/flags,
    // config/car_hotspots, config/photo_tags). Public read for runtime bootstrap.
    // Write goes through isPrivilegedStaff() so doc-role admins (users/{uid}.role ==
    // 'admin' or isAdmin: true) can save without needing a custom claim — this is
    // what unblocks the Feature Flags panel, Photo of the Week pick, and car
    // hotspots editor for the admin user.
    match /config/{docId} {
      allow read: if true;
      allow write: if isPrivilegedStaff();
    }
    
    // App configuration (version management, push notification settings)
    match /app_config/{docId} {
      // Public read for version checking in apps
      allow read: if true;
      // Only admins can update app config
      allow write: if hasRole('admin') || hasProfileRole('admin');
    }
    
    // App usage tracking (version distribution, device info)
    match /app_usage/{usageId} {
      // Apps can write their own usage data.
      // Require the payload to match the document ID to reduce spoofing.
      allow create, update: if
        (request.resource.data.fcm_token == usageId) &&
        true;
      // Admins can read all usage data
      allow read: if hasRole('admin') || hasProfileRole('admin') || hasRole('team-member') || hasProfileRole('team-member');
    }
    
    // Push notification queue (for Cloud Functions)
    match /push_notifications/{notificationId} {
      // Team members and admins can create notifications
      allow create: if isPrivilegedStaff();
      // Admins and team members can read queue status (admin inbox, ops)
      allow read: if isPrivilegedStaff();
      // Client updates restricted; Cloud Functions Admin SDK bypasses rules.
      allow update: if isPrivilegedStaff();
    }
    
    // Jonny-specific images (approvals)
    match /jonny_gallery_images/{imageId} {
      // Public can read approved images; team members/admins can read all
      allow read: if (resource.data.approved == true)
                  || hasRole('team-member')
                  || hasRole('admin')
                  || hasProfileRole('team-member')
                  || hasProfileRole('admin');
      // Uploader can create unapproved only; team members/admins can update/approve or delete
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.uploaderUid &&
        request.resource.data.approved == false;
      allow update: if isPrivilegedStaff() ||
        (isAuthenticated() &&
         request.auth.uid == resource.data.uploaderUid &&
         request.resource.data.approved == resource.data.approved);
      allow delete: if isPrivilegedStaff();
    }

    // Jonny-specific videos
    match /jonny_videos/{videoId} {
      allow read: if true;
      allow write: if isPrivilegedStaff();
    }
    
    // Client error logs (frontend)
    match /client_logs/{logId} {
      // Public create allowed for guest telemetry, but payload is size-bounded.
      // Admin UI must HTML-escape all fields (XSS sink closed separately).
      allow create: if request.resource.data.keys().hasAll(['message']) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 4000;
      allow read: if isPrivilegedStaff();
      allow delete: if isPrivilegedStaff();
    }
    
    // TikTok videos library
    match /tiktok_videos/{videoId} {
      // Any authenticated user can read videos
      allow read: if isAuthenticated();
      allow write: if hasRole('team-member') || hasRole('admin') || hasProfileRole('admin');
      allow delete: if hasRole('team-member') || hasRole('admin') || hasProfileRole('admin');
    }
    
    // Analytics page views (public write for tracking)
    match /page_views/{viewId} {
      allow create: if true; // Anyone can track page views
      allow read: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }
    
    // Analytics events (public write for tracking user interactions)
    match /analytics_events/{eventId} {
      allow create: if true; // Anyone can track events
      allow read: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }
    
    // Feedback submissions (public create; staff-only read to protect PII)
    match /feedback/{feedbackId} {
      allow create: if
        onlyHasKeys(['name', 'email', 'message', 'createdAt', 'source', 'page']) &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80)) &&
        (!('email' in request.resource.data) || isValidEmail(request.resource.data.email)) &&
        isNonEmptyString(request.resource.data.message) &&
        request.resource.data.message.size() <= 4000 &&
        (!('page' in request.resource.data) || (request.resource.data.page is string && request.resource.data.page.size() <= 120)) &&
        (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 50)) &&
        true; // Anyone can submit feedback
      allow read: if isPrivilegedStaff();
      allow update, delete: if isPrivilegedStaff();
    }

    // Email retry queues (written by Cloud Functions Admin SDK; team reads/updates in admin console)
    match /feedback_queue/{id} {
      allow read: if isPrivilegedStaff();
      allow create, update: if isPrivilegedStaff();
      allow delete: if isAdminOnly();
    }
    match /sponsorship_queue/{id} {
      allow read: if isPrivilegedStaff();
      allow create, update: if isPrivilegedStaff();
      allow delete: if isAdminOnly();
    }
    match /queue_dead_letter/{id} {
      allow read: if isPrivilegedStaff();
      allow create: if false;
      allow update, delete: if isPrivilegedStaff();
    }
    
    // Admin action logs (team-members and admins can write)
    match /admin_logs/{logId} {
      allow create: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow read: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }

    // Configuration history / change tracking
    match /config_history/{historyId} {
      allow create: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow read: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }

    // Security events captured from admin actions and suspicious flows
    match /security_events/{eventId} {
      // Authenticated create only (blocks anonymous spam/XSS payload dumps)
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['type']) &&
        request.resource.data.type is string &&
        request.resource.data.type.size() <= 120;
      allow read: if isPrivilegedStaff();
      allow update, delete: if isAdminOnly();
    }

    // Persisted health check snapshots
    match /health_checks/{checkId} {
      allow create: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow read: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }

    // Active admin alerts derived from health/security checks
    match /admin_alerts/{alertId} {
      allow create, update: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow read: if hasRole('team-member') || hasRole('admin') || hasProfileRole('team-member') || hasProfileRole('admin');
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }
    
    // Live race updates
    match /live_race/{document} {
      allow read: if true;
      allow write: if isAuthenticated() && 
        (hasRole('admin') || hasRole('team-member') || hasProfileRole('admin') || hasProfileRole('team-member'));
    }
    
    // Live race commentary feed
    match /live_race_updates/{updateId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        (hasRole('admin') || hasRole('team-member') || hasProfileRole('admin') || hasProfileRole('team-member'));
      allow delete: if hasRole('admin') || hasProfileRole('admin');
    }
    
    // Fan Wall shoutouts
    match /fan_wall/{postId} {
      // Public can read approved posts
      allow read: if (resource.data.approved == true) || isPrivilegedStaff();
      // Authenticated users can create only as unapproved posts
      allow create: if isAuthenticated() &&
        request.resource.data.approved == false &&
        (
          request.resource.data.authorUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );
      // Team/admin can approve or delete
      allow update: if isPrivilegedStaff();
      allow delete: if isPrivilegedStaff();
    }
    
    // Fan predictions
    match /predictions/{predictionId} {
      allow read: if true; // Public leaderboard
      // Authenticated users can create their own prediction; cannot set score/points.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        (!('score' in request.resource.data) || request.resource.data.score == null) &&
        (!('points' in request.resource.data) || request.resource.data.points == null || request.resource.data.points == 0);
      // Admin can score predictions
      allow update: if isPrivilegedStaff();
    }
    
    // Admin Audit Log — admin read; authenticated admin write only
    match /admin_audit/{entryId} {
      allow read: if isAdminOnly();
      allow create: if isAuthenticated() && isAdminOnly();
      allow update, delete: if false;
    }

    // Feature flags config (uses existing config/{docId} rule above — public read, admin write)
    // Explicit alias for clarity — redundant with /config/{docId} but kept for documentation
    // match /config/flags { ... } — covered by /config/{docId}

    // Per-race admin notes for Race-Day Hub
    match /race_notes/{raceId} {
      allow read: if true;
      allow write: if isAdminOnly();
    }

    // Race-day fan updates feed.
    // Code writes/reads at `race_updates/<raceId>/posts/<autoId>` — a real
    // 4-segment subcollection path. The prior 3-segment rule
    // (`/race_updates/{raceId}/{postId}`) pattern-matched a *subcollection
    // name*, never an actual doc, so every read/write fell through to the
    // default-deny block. This is what blocked the Race-Day Hub admin posts.
    match /race_updates/{raceId}/posts/{postId} {
      allow read: if true;
      allow create: if isAdminOnly();
      allow update, delete: if isAdminOnly();
    }

    // Driver-of-Day votes — code stores at `votes/<raceId>/votes/<uid>`
    // (subcollection literally named "votes" inside each race-day doc).
    // Same 3-segment rule bug as race_updates; corrected to 4 segments.
    // The parent doc rule below permits leaderboard's
    // `db.collection('votes').get()` listing.
    match /votes/{raceId} {
      allow read: if true;
      allow write: if false;
    }
    match /votes/{raceId}/votes/{uid} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Prediction scores on user profiles (sub-collection handled via users rule)
    // Scheduled push notifications
    match /scheduled_pushes/{id} {
      allow read:   if isAdminOnly();
      allow create: if isAdminOnly();
      // Client updates restricted; Cloud Functions Admin SDK bypasses rules.
      allow update: if isAdminOnly();
      allow delete: if isAdminOnly();
    }

    // Race recaps (admin write, published ones public read)
    match /race_recaps/{raceId} {
      allow read: if resource.data.published == true || isAdminOnly();
      allow write: if isAdminOnly();
    }

    // Sponsors CRM — admin only
    match /sponsors/{slug} {
      allow read:  if isAdminOnly();
      allow write: if isAdminOnly();
    }

    // Car hotspots config — public read, admin write
    match /config/car_hotspots/{driver} {
      allow read: if true;
      allow write: if isAdminOnly();
    }

    // Fan passport stamps — clients may read; writes go through checkInPassport (Admin SDK).
    match /users/{uid}/passport_stamps/{raceId} {
      allow read:   if isOwner(uid) || isAdminOnly();
      allow create, update, delete: if false;
    }

    // Default deny - catches everything not explicitly allowed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

