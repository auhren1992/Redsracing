<?xml version="1.0" encoding="utf-8"?>
<!--
  Vertical LinearLayout (not ConstraintLayout): toolbar → banner → WebView → ad → bottom_nav.
  WebView uses layout_weight so it fills leftover space only — it cannot measure/paint over
  the native tab bar after resume/compositor restore (clear-storage symptom).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/website_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/website_background"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="RedsRacing"
        app:titleTextColor="@color/white"
        app:navigationIcon="@null"
        android:contentInsetStartWithNavigation="0dp"
        android:contentInsetStart="0dp" />

    <!-- Shown whenever Firestore latest_version > installed build -->
    <LinearLayout
        android:id="@+id/update_available_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="#F59E0B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/update_available_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update available"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/update_available_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="#0F172A"
            android:text="Update"
            android:textColor="#F8FAFC"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- WebView fills leftover space only (weight=1); never overlaps bottom chrome -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/website_background"
        android:clipChildren="true"
        android:clipToPadding="true">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/website_background"
            android:layerType="hardware"
            android:overScrollMode="never"
            android:paddingBottom="0dp" />
    </FrameLayout>

    <!-- Banner Ad: collapsed until an ad loads (see MainActivity AdListener) -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="#0f172a"
        android:visibility="gone"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-8879853783053353/4189131487" />

    <!-- Bottom Navigation — last child so WebView cannot cover it; insets in MainActivity -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="#0f172a"
        android:elevation="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:clipToPadding="false"
        android:visibility="visible"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:itemPaddingTop="4dp"
        app:itemPaddingBottom="4dp"
        app:paddingBottomSystemWindowInsets="false"
        app:paddingTopSystemWindowInsets="false"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
