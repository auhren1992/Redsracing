# Local-only environment (never commit `.env`).
# Used by future scripts / tooling — Firebase web keys stay in `assets/js/firebase-config.js` for the client.

# Example placeholders:
# SENTRY_DSN=
# CUSTOM_API_KEY=

# Firebase Admin / deploy (gitignored). Copy your service-account JSON to this path:
#   functions/serviceAccountKey.json
# Optional alternate (also gitignored): secrets/generated/firebase-adminsdk.json
# GOOGLE_APPLICATION_CREDENTIALS=functions/serviceAccountKey.json
