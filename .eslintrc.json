{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "firebase": "readonly",
    "FirebaseAuthBridge": "readonly"
  },
  "rules": {
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["functions/**/*.js", "functions/**/*.cjs", "scripts/**/*.{js,cjs,mjs}"],
      "env": {
        "node": true,
        "browser": false,
        "es2021": true
      }
    }
  ]
}
